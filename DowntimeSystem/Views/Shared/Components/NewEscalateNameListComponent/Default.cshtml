@*新建联系人 *@
<div class="modal fade" id="NewModel" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document" style="width: 50%;min-width:150px;margin-top:80px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalLongTitle">新增联系人</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBody">
                <div class="row">
                    <div class="col-12">
                        <label class="form-label  warning-text"> Department 部门:</label>
                        <select id="new-department-select" class="form-control selectpicker noNull" noNull="部门" title="Select Department" data-size="6" data-live-search="true"></select>
                    </div>
                    <div class="col-12">
                        <label class="form-label  warning-text"> Project 项目:</label>
                        <select id="new-project-select" class="form-control selectpicker noNull" noNull="项目" title="Select Project" data-size="6" data-live-search="true"> </select>
                    </div>
                     <div class="col-12">
                        <label class="form-label  warning-text" for="new-jobtitle"> Job Title 职位: </label>
                        <input type='text' class="form-control noNull" noNull="职位" id='new-jobtitle' />
                    </div>
                    <div class="col-12">
                        <label class="form-label  warning-text" for="new-level"> Level 报警等级: </label>
                         <select id="new-level" class="form-control selectpicker noNull" noNull="项目" title="Select Project" data-size="6" data-live-search="true">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label  warning-text" for="new-ntid"> NTID: </label>
                        <input type='text' class="form-control noNull" noNull="NTID" id='new-ntid' />
                    </div>
                     <div class="col-12">
                        <label class="form-label  warning-text" for="new-name"> Name 姓名: </label>
                        <input type='text' class="form-control noNull" noNull="姓名" id='new-name' readonly/>
                    </div>
                     <div class="col-12">
                        <label class="form-label  warning-text" for="new-email"> eMail 邮箱: </label>
                        <input type='text' class="form-control noNull" noNull="邮箱" id='new-email' readonly/>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="Submit">Submit</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        initialModal();
        $("#new-ntid").on('change', function () {
            user_entity($(this), $('#new-name'), $('#new-email'));
        })


        $("#Submit").on('click', function () {
            if (checkFormNoNull("#NewModel")) {
                let tmp = {
                    department: $("#new-department-select").val(),
                    project: $("#new-project-select").val(),
                    jobtitle: $("#new-jobtitle").val(),
                    level: Number($("#new-level").val()),
                    englishname : $("#new-name").val(),
                    email : $("#new-email").val(),
                }
                postDatatoAPI('/EscalateNameList/Add', tmp)
                    .then(res => {
                        showSuccess("更新成功");
                        $("#table").bootstrapTable("refreshOptions", { url: '/EscalateNameList/Get' });
                        $("#NewModel").modal('hide');
                    })
                    .catch(err => {
                        showError(err);
                    })
            }
        })
    })


    function initialModal() {
        GeteCallingDepartment($("#new-department-select"));
        getProject($('#new-project-select'));
        $('#new-jobtitle').val('');
        $('#new-level').val('');
        $("#new-level").selectpicker('refresh');
        $('#new-name').val('');
        $('#new-email').val('');
    }
</script>