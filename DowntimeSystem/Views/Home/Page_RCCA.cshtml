@{
    ViewBag.Title = "Machine RCCA";
}

@*
    根据项目，部门，线体 ，站位，检索出machine，根据 machine 设定 webSocket通道
    显示项目，部门，站位，machine，WI 信息（编号，版本）
    webSocket 收到消息，根据消息内容，获取WI解析结果，显示内容在页面上
*@

<div class="container-fluid">
    <div class="row" id="searchBar">
        @await Component.InvokeAsync("DTMachineSearchComponent")
        <div class="col-lg-1  col-xs-1 col-sm-1 col-md-1" style="padding-top:27px"><button type="button" class="btn btn-primary" id="search" onclick="Set()">Set</button></div>
    </div>
    <div class="row">   
        <div class="col-6">
            <div class="card">
                <form class="card-body" id="myForm">
                    <input id="socketstatus" hidden />
                    <h6 class="card-title">Machine Info 机台信息<i class="fa  fa-toggle-off pull-right" style="font-size:20px" id="switch"></i></h6>
                    <div class="row">
                        <div class="col-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Proejct 项目</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="info-project">
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Department 部门</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="info-department">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Line 线体</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="info-line">
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Station 站位</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="info-station">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Machine 设备名</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="info-machine">
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">WI</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="info-wi" style="width: auto;">-
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="info-version">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-6">
            <div class="card">
                <div class="card-body" id="incident">
                    <h6 class="card-title" id="incident-title"> Last Downtime Incident 最新停线事件 <span class="pull-right" id="incident-id"></span></h6>
                    <div class="row">
                        <div class="col-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">StartTime 开始时间</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="incident-starttime">
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">EndTime 结束时间</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="incident-endtime">
                            </div>
                        </div>
                    </div>  
                    <div class="row">
                        <div class="col">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Issue 问题</span>
                                </div>
                                <input type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="incident-issue">
                            </div>
                        </div>
                    </div>
                        <div class="row">
                            <div class="col">
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">Issue Description 问题描述</span>
                                    </div>
                                    <textarea type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-default" readonly id="incident-description" rows="1"></textarea>
                                </div>
                            </div>                   
                        </div>
                    </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col text-center">
            <div class="row">
                <div class="col">
                    @await Component.InvokeAsync("ProgressComponent")         
                    <div style="width:100%">
                        <label style="width:100%;text-align:center">
                            WI 维修指导手册
                        </label>
                        <table id="table" style="table-layout: fixed;width:100%"></table>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/paho-mqtt.min.js"></script>
<script src="~/js/mqtt.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap-table.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap-table-filter-control.min.js"></script>

<script>
    var socket = new MQTTWebSocketHandler();
    var tabledata = null;
    var progress = new Progress(40);
    var currentdata;
    var isUpdating = false;
    $(document).ready(function () {
        $("#socketstatus").on('change', function () {
            SwitchChange(Boolean($(this).val()));
        });
    })
    //加载配置信息
    function Set() {
        if (checkFormNoNull("#searchBar")) {
            StartLoading();
            GetMachineInfo();
            GetLastDowntimeInfo($("#machine-select").val());
            GetWIInfo($("#department-select").val(), $("#project-select").val(), $("#station-select").val());   //加载WI信息
        } 
    }
    function GetMachineInfo() {
        $("#info-department").val($("#department-select").val());
        $("#info-project").val($("#project-select").val());
        $("#info-line").val($("#line-select").val());
        $("#info-station").val($("#station-select").val());
        $("#info-machine").val($("#machine-select").val());
        socket.initializeSocket($("#machine-select").val(), $("#socketstatus"), onMessageEvent);//创建WebSocket 通道
    }
    function GetWIInfo(department,project,station) {
        getData(BasicURL + '/api/DowntimeRCCA/GetRCCAFormNo', {
            Department: department,
            Project: project,
            Station: station ,
        })
            .then(res => {
                if (res[0] == undefined) {
                    $("#info-wi").val("");
                    $("#info-version").val("")
                    showWarning(department + " " + project+ " " + station+" 没有对应的WI文件，请联系管理员配置相关信息")
                } else {
                    $("#info-wi").val(res[0].formno);
                    $("#info-version").val(res[0].version);
                    InitialRCCATable();
                }
            })
            .catch(err => {
                showError(err);
            })
    }
    function GetLastDowntimeInfo(machine) {
        getData(BasicURL + '/api/Downtime/Query_LastIncdentByFilter', {
            Machine: machine
        })
            .then(res => {
                if (res==null) {
                    showWarning("未查询到 " + machine +" 相关的Downtime记录")
                } else {
                    ShowDTinfo(res);
                    currentdata = res;
                }
            })
            .catch(err => {
                showError(err);
            })
    }

    //接受到Downtime信息，触发的动作
    function onMessageEvent(data) {
        ShowDTinfo(data);
        if ($("#info-wi").val() != "") {
            ShowRCCA(data);
        }
    }
    function ShowDTinfo(data) {
        $("#incident-title").addClass("white-font");
        if (data.incidentstatus == 0) {
            $("#incident").removeClass("color-green");
            $("#incident").addClass("color-red");
        }
        else if (data.incidentstatus == 2) {
            $("#incident").removeClass("color-red");
            $("#incident").addClass("color-green");
        } else {
            $("#incident").removeClass("color-red");
            $("#incident").removeClass("color-green");
            $("#incident-title").removeClass("white-font");
        }
        $("#incident-id").html(data.id);
        $("#incident-starttime").val(new Date(data.occurtime).format('yyyy-MM-dd hh:mm:ss'));
        $("#incident-endtime").val(new Date(data.finishtime).format('yyyy-MM-dd hh:mm:ss'));
        $("#incident-issue").val(data.issue);
        $("#incident-description").val(data.issueremark);
    }
    function InitialRCCATable() {
        isUpdating = false;
        getData(BasicURL + "/api/DowntimeRCCA/AnalysisRCCAByStation", {
            formNo: $("#info-wi").val(),
            station: $("#info-station").val()
        })
            .then(res => {
                tabledata = res;
                $("#table").bootstrapTable('destroy').bootstrapTable({
                    data: res,
                    cache: false,
                    type: 'GET',
                    filterControl: true,
                    columns:  [{
                        field: 'errorCode',
                        width:1,
                        title: 'Error Code</br>异常代码',
                        filterControl: 'select' // 使用下拉菜单进行筛选
                    }, {
                        field: 'issue',
                        width: 2,
                        title: 'Issue</br>问题描述',
                        filterControl: 'select' // 使用下拉菜单进行筛选
                    }, {
                        field: 'totalqty',
                        width: 1,
                        title: 'Accumulative QTY</br>累计数量',
                        align: 'center',
                        valign: 'middle',
                    }, {
                        field: 'totalPercent',
                        width: 1,
                        title: 'Percentage%</br> 累计占比',
                        align: 'center',
                        valign: 'middle',
                    }, {
                        field: 'issuePic',
                        width: 2,
                        title: 'Issue Photo </br> 问题图片',
                        formatter: function (value) {
                            if (value != null) {
                                return `<img src="data:image/png;base64,${value}" alt="Image" style="width: 100%; height: auto;" />`;
                            }
                        }
                    }, {
                        field: 'checkStep',
                        width: 4,
                        title: 'Check Step </br> 检查步骤',
                        align: 'left',
                    }, {
                        field: 'checkStepPic',
                        width: 2,
                        title: 'Step Photo </br> 检查步骤图片',
                        formatter: function (value) {
                            if (value != null) {
                                return `<img src="data:image/png;base64,${value}" alt="Image" style="width: 100%; height: auto;" />`;
                            }
                        }
                    }, {
                        field: 'rootCause',
                        width: 2,
                        title: 'RootCause </br> 根本原因',
                    }, {
                        field: 'correctiveAction',
                        width: 2,
                        title: 'CA </br> 纠正措施',
                    }, {
                        field: 'tool',
                        width: 1,
                        title: 'Tools </br> 工具',
                    }, {
                        field: 'correctiveActionPic',
                        width: 2,
                        title: 'CA Photo </br> 纠正措施图片',
                        formatter: function (value) {
                            if (value != null) {
                                return `<img src="data:image/png;base64,${value}" alt="Image" style="width: 100%; height: auto;" />`;
                            }
                        }
                    }, {
                        field: 'correctiveStep',
                        width: 4,
                        title: 'Corrective Step </br> 纠正步骤',
                        align: 'left',
                    }, {
                        field: 'correctiveStepPic',
                        width: 2,
                        title: 'Corrective Step Photo </br> 纠正步骤图片',
                        formatter: function (value) {
                            if (value != null) {
                                return `<img src="data:image/png;base64,${value}" alt="Image" style="width: 100%; height: auto;" />`;
                            }
                        }
                    }, {
                        field: 'qty',
                        title: 'Sub QTY</br>子项数量',
                        width: 1,
                        align: 'center',
                        valign: 'middle',
                    }, {
                        field: 'subPercent',
                        title: 'Sub Percentage%</br>子项百分比',
                        width: 1,
                        align: 'center',
                        valign: 'middle',
                    }, {
                        field: 'remark',
                        width: 1,
                        title: 'Remark </br> 备注',
                    }],
                    onPostHeader: function () {
                        // 遍历每一个表头，设置title属性为单元格文字
                        $('#table thead th').each(function () {
                            var $this = $(this);
                            $this.attr('title', $this.text());
                        });
                        $('#table thead th').css('text-align', 'center');
                        $('#table thead th').css('vertical-align', 'top');
                    }
                });
                ShowRCCA(currentdata);
            })
            .catch(err => {
                showError(err);
                EndLoading();
            })
    }
    function ShowRCCA(data) {
        if (data.incidentstatus == 0) {
            var tmp = tabledata.filter(j => j.issue == data.issue);
            $('#table').bootstrapTable('load', tmp);
        } else if (data.incidentstatus == 2) {
            $('#table').bootstrapTable('load', tabledata);
        }
        setTimeout(function () {
            var data = $('#table').bootstrapTable('getData', true);
            //合并单元格
            mergeCells(data, "issue", 1, $('#table'));
        },500)
        EndLoading();
    }
    function StartLoading() {
        progress.show();
        btnDisable($('#search'));
    }

    function EndLoading() {
        progress.hide();
        btnEnable($('#search'));
    }

    //修改Socket开关状态
    function SwitchChange(isopen) {
        if (isopen) {
            $("#switch").removeClass("fa-toggle-off");
            $("#switch").addClass("fa-toggle-on");
            $("#switch").addClass("green-font");
            console.log("WebSocket 已开启");
        } else{
            $("#switch").removeClass("fa-toggle-on");
            $("#switch").addClass("fa-toggle-off");
            $("#switch").removeClass("green-font");
            console.log("WebSocket 已关闭");
        }
    }
</script>