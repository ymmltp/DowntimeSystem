@{
    ViewData["Title"] = "Manage Machine";
}

<div class="container-fluid">
    <div class="panel-default">
        <div class="panel-heading"><i class="fa fa-cogs "></i> @ViewData["Title"]</div>
        <div class="panel-body">
            <div class="row">
                <div class="col-lg-2 col-md-3">
                    <label class="form-label">Station:</label>
                    <select id="station-select" class="form-control selectpicker" title="Select Station" data-size="6" multiple data-max-options="1" data-live-search="true"></select>
                </div>
                <div class="col-lg-1 col-md-2" style="padding-top:27px">
                    <button type="button" class="btn btn-primary" onclick="GetMachineTable()">Search</button>
                </div>
                <div class="col-lg-1 col-md-2" style="padding-top:27px">
                    <button type="button" class="btn btn-success" id="btnNew">新增</button>
                </div>
            </div>
        </div>
    </div>
    <table id="machine-table" class="table table-striped table-hover"></table>
</div>

<!-- New Modal -->
<div class="modal fade" id="MachineModal" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document" style="width:30%;min-width:300px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Machine</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body" id="modalBody">
                <div class="form-group">
                    <label class="form-label">Station:</label>
                    <select id="input-station" class="form-control selectpicker noNull" noNull="Station" title="Select Station" data-size="6" multiple data-max-options="1" data-live-search="true"></select>
                </div>
                <div class="form-group">
                    <label class="form-label">Machine Name:</label>
                    <input type="text" class="form-control noNull" id="input-name" noNull="Machine Name" />
                </div>
                <div class="form-group">
                    <label class="form-label">Machine Number:</label>
                    <input type="text" class="form-control" id="input-number" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="btnSubmit">Submit</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/customer.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap-table.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap-editable.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap-table-editable.js"></script>
<script>
    var apiBase = BasicURL + '/api/DowntimeHierarchy/';

    $(function () {
        loadStationOptions($('#station-select'));

        $('#btnNew').on('click', function () {
            $('#input-name').val('');
            $('#input-number').val('');
            $('#MachineModal').modal('show');
        });

        $('#MachineModal').on('shown.bs.modal', function () {
            loadStationOptions($('#input-station'));
        });

        $('#btnSubmit').on('click', function () {
            if (!checkFormNoNull('#modalBody')) return;
            var data = {
                station: $('#input-station').val()[0],
                machinename: $('#input-name').val(),
                machinenumber: $('#input-number').val()
            };
            postDatatoAPI(apiBase + 'AddMachine', data)
                .then(function () {
                    showSuccess("添加成功");
                    $('#MachineModal').modal('hide');
                    $('#machine-table').bootstrapTable('refresh');
                })
                .catch(function (err) { showError(err); });
        });
    });

    function loadStationOptions(obj) {
        $.ajax({
            url: apiBase + 'GetStations',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                var option = '';
                for (var i = 0; i < data.length; i++) {
                    option += '<option value="' + data[i].name + '">' + data[i].name + '</option>';
                }
                obj.html(option).selectpicker('refresh');
            }
        });
    }

    function GetMachineTable() {
        var station = $('#station-select').val() ? $('#station-select').val()[0] : null;
        $('#machine-table').bootstrapTable('destroy').bootstrapTable({
            url: apiBase + 'GetMachines',
            queryParams: { station: station },
            cache: false,
            type: 'GET',
            dataType: 'json',
            search: true,
            pagination: true,
            paginationLoop: false,
            pageSize: 10,
            pageList: '[10, 50, 100, ALL]',
            columns: [{
                field: 'index',
                title: 'No.',
                formatter: function (v, r, i) { return i + 1; }
            }, {
                field: 'station',
                title: 'Station',
                sortable: true,
                editable: { type: 'text', mode: 'inline', validate: function (v) { if (!$.trim(v)) return 'Cannot be empty.'; } }
            }, {
                field: 'machinename',
                title: 'Machine Name',
                sortable: true,
                editable: { type: 'text', mode: 'inline', validate: function (v) { if (!$.trim(v)) return 'Cannot be empty.'; } }
            }, {
                field: 'machinenumber',
                title: 'Machine Number',
                sortable: true,
                editable: { type: 'text', mode: 'inline' }
            }, {
                field: 'ctime',
                title: 'Create Time',
                sortable: true,
                formatter: function (v) { return v ? v.replace('T', ' ').substring(0, 19) : ''; }
            }, {
                field: 'operation',
                title: '操作',
                formatter: function () {
                    return '<a href="#" class="text-danger btn-del">Delete</a>';
                },
                events: {
                    'click .btn-del': function (e, value, row) {
                        if (confirm('确定删除 "' + row.station + ' - ' + row.machinename + '" 吗？')) {
                            deleteDatatoAPI(apiBase + 'DeleteMachine?id=' + row.id)
                                .then(function () {
                                    showSuccess("删除成功");
                                    $('#machine-table').bootstrapTable('refresh');
                                })
                                .catch(function (err) { showError(err); });
                        }
                    }
                }
            }],
            onEditableSave: function (field, row) {
                var data = { id: row.id, station: row.station, machinename: row.machinename, machinenumber: row.machinenumber };
                $.ajax({
                    url: apiBase + 'UpdateMachine',
                    type: 'PUT',
                    contentType: 'application/json',
                    beforeSend: function (xhr) { xhr.setRequestHeader('Access-Control-Allow-Origin', '*'); },
                    data: JSON.stringify(data),
                    success: function () { showSuccess("更新成功"); },
                    error: function (err) { showError(err.responseText); }
                });
            }
        });
    }
</script>
