@{
    ViewData["Title"] = "Manage Basic Data";
}

<div class="container-fluid">
    <div class="panel-default">
        <div class="panel-heading"><i class="fa fa-cogs "></i> @ViewData["Title"]</div>
    </div>
    <ul id="basicTab" class="nav nav-tabs" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab-building">Building</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-department">Department</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-workcell">Workcell</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-line">Line</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-station">Station</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-area">Production Area</a></li>
    </ul>
    <div class="tab-content border border-top-0" style="padding:10px">
        <div class="tab-pane fade show active" id="tab-building"></div>
        <div class="tab-pane fade" id="tab-department"></div>
        <div class="tab-pane fade" id="tab-workcell"></div>
        <div class="tab-pane fade" id="tab-line"></div>
        <div class="tab-pane fade" id="tab-station"></div>
        <div class="tab-pane fade" id="tab-area"></div>
    </div>
</div>

<!-- New Modal -->
<div class="modal fade" id="BasicDataModal" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document" style="width:30%;min-width:300px">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">New Item</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body" id="modalBody">
                <div class="form-group">
                    <label class="form-label">Name:</label>
                    <input type="text" class="form-control noNull" id="input-name" noNull="Name" />
                </div>
                <div class="form-group">
                    <label class="form-label">Description:</label>
                    <input type="text" class="form-control noNull" id="input-desc" noNull="Description" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="btnSubmit">Submit</button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap-table.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap-editable.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap-table-editable.js"></script>
<script>
    // API config per entity: getAll, add, update, delete action names
    var apiBase = BasicURL + '/api/DowntimeHierarchy/';
    var tabConfig = {
        'tab-building':   { label: 'Building',        get: 'GetBuildings',       add: 'AddBuilding',       update: 'UpdateBuilding',       del: 'DeleteBuilding' },
        'tab-department':  { label: 'Department',      get: 'GetDepartments',     add: 'AddDepartment',     update: 'UpdateDepartment',     del: 'DeleteDepartment' },
        'tab-workcell':    { label: 'Workcell',        get: 'GetWorkcells',       add: 'AddWorkcell',       update: 'UpdateWorkcell',       del: 'DeleteWorkcell' },
        'tab-line':        { label: 'Line',            get: 'GetLines',           add: 'AddLine',           update: 'UpdateLine',           del: 'DeleteLine' },
        'tab-station':     { label: 'Station',         get: 'GetStations',        add: 'AddStation',        update: 'UpdateStation',        del: 'DeleteStation' },
        'tab-area':        { label: 'Production Area', get: 'GetProductionAreas', add: 'AddProductionArea', update: 'UpdateProductionArea', del: 'DeleteProductionArea' },
    };

    var currentTab = 'tab-building';

    $(function () {
        loadTable('tab-building');

        $('#basicTab a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            currentTab = $(e.target).attr('href').substring(1);
            loadTable(currentTab);
        });

        $('#btnSubmit').on('click', function () {
            if (!checkFormNoNull('#modalBody')) return;
            var cfg = tabConfig[currentTab];
            postDatatoAPI(apiBase + cfg.add, { name: $('#input-name').val(), description: $('#input-desc').val() })
                .then(function () {
                    showSuccess("添加成功");
                    $('#BasicDataModal').modal('hide');
                    $('#' + currentTab).find('table').bootstrapTable('refresh');
                })
                .catch(function (err) { showError(err); });
        });
    });

    function loadTable(paneId) {
        var $pane = $('#' + paneId);
        var cfg = tabConfig[paneId];
        if ($pane.find('table').length === 0) {
            $pane.html(
                '<div class="mb-2"><button class="btn btn-success btn-new">新增</button></div>' +
                '<table id="table-' + paneId + '" class="table table-striped table-hover"></table>'
            );
            $pane.find('.btn-new').on('click', function () {
                $('#modalTitle').text('New ' + cfg.label);
                $('#input-name').val('');
                $('#input-desc').val('');
                $('#BasicDataModal').modal('show');
            });
        }
        initTable('table-' + paneId, cfg);
    }

    function initTable(tableId, cfg) {
        $('#' + tableId).bootstrapTable('destroy').bootstrapTable({
            url: apiBase + cfg.get,
            cache: false,
            type: 'GET',
            dataType: 'json',
            search: true,
            pagination: true,
            paginationLoop: false,
            pageSize: 10,
            pageList: '[10, 50, 100, ALL]',
            columns: [{
                field: 'index',
                title: 'No.',
                formatter: function (v, r, i) { return i + 1; }
            }, {
                field: 'name',
                title: 'Name',
                sortable: true,
                editable: { type: 'text', mode: 'inline', validate: function (v) { if (!$.trim(v)) return 'Cannot be empty.'; } }
            }, {
                field: 'description',
                title: 'Description',
                sortable: true,
                editable: { type: 'text', mode: 'inline' }
            }, {
                field: 'ctime',
                title: 'Create Time',
                sortable: true,
                formatter: function (v) { return v ? v.replace('T', ' ').substring(0, 19) : ''; }
            }, {
                field: 'operation',
                title: '操作',
                formatter: function () {
                    return '<a href="#" class="text-danger btn-del">Delete</a>';
                },
                events: {
                    'click .btn-del': function (e, value, row) {
                        if (confirm('确定删除 "' + row.name + '" 吗？')) {
                            deleteDatatoAPI(apiBase + cfg.del + '?id=' + row.id)
                                .then(function () {
                                    showSuccess("删除成功");
                                    $('#' + tableId).bootstrapTable('refresh');
                                })
                                .catch(function (err) { showError(err); });
                        }
                    }
                }
            }],
            onEditableSave: function (field, row) {
                var data = { id: row.id, name: row.name, description: row.description };
                $.ajax({
                    url: apiBase + cfg.update,
                    type: 'PUT',
                    contentType: 'application/json',
                    beforeSend: function (xhr) { xhr.setRequestHeader('Access-Control-Allow-Origin', '*'); },
                    data: JSON.stringify(data),
                    success: function () { showSuccess("更新成功"); },
                    error: function (err) { showError(err.responseText); }
                });
            }
        });
    }
</script>
